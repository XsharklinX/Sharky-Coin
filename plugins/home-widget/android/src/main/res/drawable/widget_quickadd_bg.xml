<?xml version="1.0" encoding="utf-8"?>
<!--
  Fondo del acceso rápido 1x1. Antes era un azul plano de 2 paradas: se veía
  chato, como un rectángulo cualquiera. Ahora es un botón: degradado vertical
  "iluminado desde arriba" (claro arriba → azul de marca → azul profundo) más
  un borde translúcido que le da canto de vidrio. Es el mismo lenguaje del FAB
  "+" que vive dentro de la app, para que se reconozca como "agregar".
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="270"
        android:startColor="#6493FF"
        android:centerColor="#4D82FF"
        android:endColor="#2F63E6" />
    <stroke
        android:width="1dp"
        android:color="#40FFFFFF" />
    <corners android:radius="22dp" />
</shape>
